<Window x:Class="HexViewer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск" Width="540" Height="250" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontSize="15">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Найти:" FontSize="15" VerticalAlignment="Center" Margin="0 0 0 0"/>
            
            <TextBox Grid.Column="1" x:Name="SearchTextBox" Height="30" FontSize="15" Margin="10 0 0 0"
                     HorizontalAlignment="Stretch" Padding="0 -2 0 -2"
                     TextChanged="SearchTextBox_TextChanged"/>


            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5 0 0 0">
                <Button Content="Найти" Click="Find_Click" Padding="16 3" Margin="0 0 6 0" IsDefault="True"/>
                <Button Content="⯇" Click="Previous_Click" Width="34" MinWidth="34" Padding="0" FontSize="15" Margin="0 0 4 0"/>
                <Button Content="⯈" Click="Next_Click" Width="34" MinWidth="34" Padding="0" FontSize="15"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="ResultText" FontSize="15" Margin="0 8 0 0"
                   Foreground="#444444" TextWrapping="Wrap"/>

        <Grid Grid.Row="2" Margin="0 16 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton Grid.Row="0" Grid.Column="0" Content="Hex" Tag="Hex" GroupName="SearchKind"
                         IsChecked="True" Margin="0 0 0 8" Checked="SearchKind_Checked"/>
            <RadioButton Grid.Row="1" Grid.Column="0" Content="Dec" Tag="Decimal" GroupName="SearchKind"
                         Margin="0 0 0 8" Checked="SearchKind_Checked"/>
            <RadioButton Grid.Row="2" Grid.Column="0" Content="Float" Tag="Float32" GroupName="SearchKind"
                         Checked="SearchKind_Checked"/>
            <RadioButton Grid.Row="0" Grid.Column="1" Content="Str UTF-8" Tag="Utf8" GroupName="SearchKind"
                         Margin="0 0 0 8" Checked="SearchKind_Checked"/>
            <RadioButton Grid.Row="1" Grid.Column="1" Content="Str Windows-1251" Tag="Windows1251" FontSize="15" 
                         GroupName="SearchKind" Checked="SearchKind_Checked"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0 5 0 0">
            <StackPanel x:Name="SearchSizePanel" Orientation="Horizontal" Visibility="Collapsed"
                        Margin="0 0 0 8">
                <TextBlock Text="Размер:" FontSize="15" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <RadioButton Content="Авто" Tag="Auto" GroupName="SearchSize" IsChecked="True"
                             Margin="0 0 12 0" Checked="SearchSize_Checked"/>
                <RadioButton Content="1 байт" Tag="Byte1" GroupName="SearchSize"
                             Margin="0 0 12 0" Checked="SearchSize_Checked"/>
                <RadioButton Content="2 байта" Tag="Byte2" GroupName="SearchSize"
                             Margin="0 0 12 0" Checked="SearchSize_Checked"/>
                <RadioButton Content="4 байта" Tag="Byte4" GroupName="SearchSize"
                             Checked="SearchSize_Checked"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
                <TextBlock Text="Искать:" FontSize="15" VerticalAlignment="Center" Margin="0 0 10 0"/>
                <RadioButton Content="Сначала" Tag="False" GroupName="SearchStart" IsChecked="True"
                             Margin="0 0 12 0" Checked="SearchStart_Checked"/>
                <RadioButton Content="С текущего места" Tag="True" GroupName="SearchStart"
                             Checked="SearchStart_Checked"/>
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
