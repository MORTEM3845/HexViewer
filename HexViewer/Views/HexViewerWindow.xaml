<Window x:Class="HexViewer.HexViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HexViewer.Control.HexViewer"
        Title="Просмотр HEX" Height="600" Width="1200" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontSize="15">

    <Window.CommandBindings>
        <CommandBinding Command="Find" Executed="FindCommand_Executed"/>
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="Find" Key="F" Modifiers="Control"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>

            <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0 1 6 0"/>
            </Style>
            <Style x:Key="ToolbarComboBoxStyle" TargetType="ComboBox"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ToolbarTextBoxStyle" TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="26"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" MinHeight="38" Padding="8 5 8 1" Background="#F7F7F7"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0 0 0 1">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0 0 20 4">
                    <TextBlock Text="Смещение:" Style="{StaticResource ToolbarLabelStyle}"
                               ToolTip="Визуальный сдвиг данных вправо на 0–3 байта"/>
                    <ComboBox x:Name="VisualOffsetBox" Width="60" Style="{StaticResource ToolbarComboBoxStyle}"
                              SelectedIndex="0" SelectionChanged="VisualOffsetBox_SelectionChanged"
                              ToolTip="0 — без смещения; 1–3 — пустые позиции перед первым байтом">
                        <ComboBoxItem Content="0"/>
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 20 4">
                    <TextBlock Text="Адрес:" Style="{StaticResource ToolbarLabelStyle}" Margin="0 1 3 0"/>
                    <TextBox x:Name="AddressBox" Width="120" Style="{StaticResource ToolbarTextBoxStyle}"
                             ToolTip="Адрес в HEX, например FF или 0xFF" Margin="0 0 6 0"/>
                    <Button Content="Перейти" Click="GoToAddress_Click"
                            Style="{StaticResource ToolbarButtonStyle}" Padding="10 0"/>
                </StackPanel>

                <Button Content="Поиск" Click="OpenSearch_Click" ToolTip="Открыть окно поиска (Ctrl+F)"
                        Style="{StaticResource ToolbarButtonStyle}" Padding="12 0" Margin="0 0 20 4"/>

                <CheckBox x:Name="ShowAsciiCheckBox" Content="Показывать ASCII"
                          Checked="ShowAsciiCheckBox_Changed" Unchecked="ShowAsciiCheckBox_Changed" VerticalAlignment="Center"
                          Margin="0 0 20 4"/>

                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                    <TextBlock Text="Кодировка:" Style="{StaticResource ToolbarLabelStyle}"/>
                    <ComboBox x:Name="TextEncodingBox" Width="130" Style="{StaticResource ToolbarComboBoxStyle}"
                              SelectedIndex="0" SelectionChanged="TextEncodingBox_SelectionChanged"
                              IsEnabled="{Binding IsChecked, ElementName=ShowAsciiCheckBox}">
                        <ComboBoxItem Content="ASCII" Tag="Ascii"/>
                        <ComboBoxItem Content="UTF-8" Tag="Utf8"/>
                        <ComboBoxItem Content="Windows-1251" Tag="Windows1251"/>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <local:HexViewer x:Name="HexViewerControl" Grid.Column="0" Margin="8 4 6 8"
                             Columns="32" IsEditable="False" ShowMoreButtonEnabled="False"/>

            <ScrollBar x:Name="VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Margin="0 4 8 8"
                       SmallChange="1"
                       LargeChange="{Binding VisibleRows, ElementName=HexViewerControl}"
                       ViewportSize="{Binding VisibleRows, ElementName=HexViewerControl}"/>
        </Grid>
    </DockPanel>
</Window>
