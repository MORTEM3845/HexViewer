<Window x:Class="HexViewerDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:HexViewer.Control.HexViewer;assembly=HexViewer"
        xmlns:editor="clr-namespace:HexViewer.Control.HexEditor;assembly=HexViewer"
        Title="HexViewer — WPF demo" Width="1080" Height="780" MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8" FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="HexViewer" FontSize="30" FontWeight="SemiBold" Foreground="#142C43"/>
            <TextBlock Text="Просмотр и редактирование бинарных данных · WPF / .NET 8" Foreground="#536679" Margin="0,5,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,18">
            <Button Content="Открыть просмотр" Click="OpenViewer_Click"/>
            <Button Content="Открыть редактор" Click="OpenEditor_Click"/>
            <Button Content="Сбросить пример" Click="Reset_Click"/>
        </WrapPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#DAE2E9" BorderThickness="1" Padding="18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Просмотр пакета" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Двойной щелчок — редактор. ПКМ — копирование, поиск и числовое представление."
                           Foreground="#536679" Margin="0,0,0,14"/>
                <viewer:HexViewer x:Name="Preview" Columns="16" VisibleRows="5" ShowAscii="True"
                                  IsEditable="True" ShowMoreButtonEnabled="False"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#DAE2E9" BorderThickness="1" Padding="18">
            <StackPanel>
                <TextBlock Text="Редактирование в поле" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Выделите байты и введите HEX. Ctrl+Z / Ctrl+Y — отмена и повтор."
                           Foreground="#536679" Margin="0,0,0,14"/>
                <editor:HexEditor x:Name="InlineEditor" Columns="16" VisibleRows="4" ShowAscii="True" IsInline="True"/>
                <TextBlock Text="Цельное HEX-слово" FontWeight="SemiBold" Margin="0,18,0,8"/>
                <viewer:HexViewer x:Name="WordPreview" DisplayMode="Word" Columns="8" VisibleRows="1"
                                  ShowMoreButtonEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
